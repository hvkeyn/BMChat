<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation_container"
    android:layout_width="fill_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        android:cacheColorHint="?conversation_background"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/no_messages_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible"
        style="@style/NoMessagesTextView"
        tools:text="@string/chat_new_one_to_one_hint" />

    <View
        android:id="@+id/bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="@drawable/compose_divider_background"
        android:alpha="1" />

    <ImageButton
        android:id="@+id/floating_location_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginTop="8dp"
        android:layout_gravity="top|end"
        android:padding="5dp"
        android:background="?attr/floating_mini_bg"
        android:elevation="1dp"
        android:alpha="0.9"
        android:contentDescription="Location streaming enabled"
        android:src="@drawable/ic_location_on_white_24dp"
        android:tint="@color/location_icon" />

    <ImageButton
        android:id="@+id/scroll_to_bottom_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="bottom|end"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="?attr/floating_mini_bg"
        android:tint="@color/gray50"
        android:elevation="1dp"
        android:alpha="0.9"
        android:contentDescription="@string/menu_scroll_to_bottom"
        android:src="@drawable/ic_search_down" />

    <org.thoughtcrime.securesms.reactions.AddReactionView
        android:id="@+id/add_reaction_view"
        android:visibility="invisible"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@android:color/transparent">

        <!-- Row 1: Telegram-style emoji reaction picker. Tap inserts
             the emoji as a reaction. The "⋯" tile opens the full
             emoji picker for any other character. -->
        <LinearLayout
            android:id="@+id/add_reaction_row"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:background="@drawable/reaction_pill_background">

            <!-- BMChat 2.49.67: added 🔥 as one of the quick reactions
                 (replacing 🙁 which was rarely used in our chats).
                 Selection by position: 👍 ❤️ 🔥 😂 👎 → Telegram-style
                 order so the most popular ones live in the middle. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_0"
                android:text="👍"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_1"
                android:text="❤️"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_2"
                android:text="🔥"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_3"
                android:text="😂"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_4"
                android:text="👎"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reaction_any"
                android:text="⋯"
                android:textColor="?attr/pref_icon_tint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AddReaction" />
        </LinearLayout>

        <!-- Row 2: Telegram-style one-tap action icons. Same pill
             background, just below the reactions. Visibility of
             each icon is decided at runtime depending on the chat
             type (canSend, canReply, isOutgoing, hasFile…). -->
        <LinearLayout
            android:id="@+id/add_reaction_actions"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:background="@drawable/reaction_pill_background">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_reply"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/notify_reply_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="?menu_reply_icon"
                app:tint="?attr/pref_icon_tint" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_quote_fragment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/bmchat_quote_selection"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_format_quote_24"
                app:tint="?attr/pref_icon_tint" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_edit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/edit_message"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_create_white_24dp"
                app:tint="?attr/pref_icon_tint" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_copy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/menu_copy_text_to_clipboard"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="?menu_copy_icon"
                app:tint="?attr/pref_icon_tint" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/menu_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="?menu_forward_icon"
                app:tint="?attr/pref_icon_tint" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete_24"
                app:tint="?attr/pref_icon_tint" />
        </LinearLayout>
    </org.thoughtcrime.securesms.reactions.AddReactionView>

</FrameLayout>
