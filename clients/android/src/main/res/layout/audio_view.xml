<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/audio_widget_container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/play_pause_holder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:visibility="visible"
                    android:background="@drawable/ic_circle_fill_white_48dp"
                    android:backgroundTint="@color/audio_icon"
                    android:src="@drawable/play_icon"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/menu_play" />

                <org.thoughtcrime.securesms.components.BMChatDownloadOverlay
                    android:id="@+id/audio_download_overlay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:longClickable="false" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:layout_gravity="center_vertical"
                    android:progressTint="@color/audio_icon"
                    android:progressTintMode="src_in"
                    android:thumbTint="@color/audio_icon"
                    android:thumbTintMode="src_in" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/audio_icon"
                        style="@style/Signal.Text.Caption"
                        android:autoLink="none"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:layout_marginEnd="8dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/audio_icon"
                        style="@style/Signal.Text.Caption"
                        android:autoLink="none"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/playback_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/audio_icon"
                        style="@style/Signal.Text.Caption"
                        android:singleLine="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/bmchat_playback_speed"
                        android:visibility="gone"
                        tools:text="1.5×"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bmchat_transfer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

        <TextView
            android:id="@+id/bmchat_transfer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/audio_icon"
            android:visibility="gone"
            tools:text="Receiving · 1.2 MB"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bmchat_transfer_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorAccent"
            app:trackColor="@color/bmchat_transfer_track"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp"
            tools:visibility="visible" />

        <Button
            android:id="@+id/bmchat_transfer_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/bmchat_transfer_cancel"
            android:textAllCaps="false"
            android:textColor="@color/audio_icon"
            android:visibility="gone"
            tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- transparent overlay to easily block clicks in audio player's components in multi-select mode -->
    <LinearLayout
        android:id="@+id/interception_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone" />

</merge>
