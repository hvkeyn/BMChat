<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor for a single EmailBotConfig. Holds name/description/webhook
  fields plus a dynamic "commands" section managed by
  EmailBotEditActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:contentInsetStart="14dp"
        app:contentInsetLeft="14dp"
        android:theme="?attr/actionBarStyle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bmchat_email_bot_field_name"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/email_bot_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true"
                android:hint="@string/bmchat_email_bot_field_name_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bmchat_email_bot_field_name_subhint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bmchat_email_bot_field_display_name"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/email_bot_display_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true"
                android:hint="@string/bmchat_email_bot_field_display_name_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bmchat_email_bot_field_description"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/email_bot_description_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:hint="@string/bmchat_email_bot_field_description_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bmchat_email_bot_field_developer_email"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/email_bot_developer_email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:hint="@string/bmchat_email_bot_field_developer_email_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bmchat_email_bot_field_developer_email_subhint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:background="?android:attr/listDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bmchat_email_bot_enabled"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/email_bot_enabled_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bmchat_email_bot_enabled_hint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bmchat_email_bot_field_commands"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bmchat_email_bot_field_commands_hint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:id="@+id/email_bot_commands_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/email_bot_add_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bmchat_email_bot_add_command" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bmchat_email_bot_field_webhook"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bmchat_email_bot_field_webhook_hint"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/email_bot_webhook_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="textUri"
                android:hint="@string/bmchat_email_bot_field_webhook_placeholder" />

            <View
                android:id="@+id/email_bot_token_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:background="?android:attr/listDivider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/email_bot_token_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bmchat_email_bot_token_label"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/email_bot_token_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textIsSelectable="true"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/email_bot_token_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmchat_email_bot_token_copy" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/bmchat_email_bot_api_docs_link"
                    android:textSize="12sp"
                    android:autoLink="web"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/email_bot_save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/bmchat_email_bot_save" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/email_bot_delete_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bmchat_email_bot_delete"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
