<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen preview for one queued bot post. Mirrors the way
  ConversationItem renders an outgoing photo bubble (image on top,
  Markdown-rendered caption below, status row at the bottom) so the
  user can see EXACTLY what the post will look like once mirrored
  into a chat. The action bar at the bottom carries the same three
  controls as the queue card — publish, schedule, delete — plus a
  prominent "Опубликовать" primary button so the action is reachable
  without having to scroll long media-rich posts.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:contentInsetStart="14dp"
            app:contentInsetLeft="14dp"
            android:elevation="4dp"
            android:theme="?attr/actionBarStyle" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/preview_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/preview_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:singleLine="true"
                android:background="@drawable/bot_status_badge_pending" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bot_card_bg">

                <ImageView
                    android:id="@+id/preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@string/bmchat_bots_queue_preview_title" />
            </FrameLayout>

            <TextView
                android:id="@+id/preview_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/preview_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorPrimary"
        android:elevation="6dp"
        android:padding="8dp">

        <Button
            android:id="@+id/preview_publish_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/bmchat_bots_queue_publish" />

        <ImageButton
            android:id="@+id/preview_schedule_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_schedule_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bmchat_bots_queue_schedule" />

        <ImageButton
            android:id="@+id/preview_delete_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bmchat_bots_queue_drop" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
