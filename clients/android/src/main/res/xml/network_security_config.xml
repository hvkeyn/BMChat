<?xml version="1.0" encoding="utf-8"?>
<!--
  BMChat: by default we still REQUIRE TLS for any host (cleartextTrafficPermitted=false).
  The single exception is the BMChat distribution VPS at 5.187.4.132, which serves the
  invite landing page, the auto-update manifest (/update.json), and the APK itself over
  plain HTTP. This is acceptable because:
    * the invite payload is in the URL fragment and never reaches the server,
    * the update manifest pins a SHA-256 of the APK and the app verifies that hash
      after download,
    * the APK is an Android-signed package and PackageManager rejects mismatched
      signatures during install.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">5.187.4.132</domain>
    </domain-config>
</network-security-config>
