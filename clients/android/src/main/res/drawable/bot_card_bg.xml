<?xml version="1.0" encoding="utf-8"?>
<!--
  Soft rounded background for pending-post cards. Uses a low-alpha
  neutral fill so it works on both light and dark themes without us
  having to maintain a separate per-theme drawable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="#14808080" />
    <stroke android:width="1dp" android:color="#1A808080" />
</shape>
