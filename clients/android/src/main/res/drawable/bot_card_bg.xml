<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded background for pending-post cards. Colors are night-qualified so
  the card stays visible on the black dark-theme window as well as on the
  white light-theme one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/bmchat_surface_card" />
    <stroke android:width="1dp" android:color="@color/bmchat_surface_card_stroke" />
</shape>
