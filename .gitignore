# Dependencies
node_modules/
**/node_modules/

# Build output
/dist/
/build/
/out/
target/
bundle_out/
html-dist/
DerivedData/
.gradle/
captures/

# Desktop packaging
clients/desktop/packages/target-electron/dist/
clients/desktop/packages/target-electron/electron-builder.json5
clients/desktop/packages/target-electron/html-dist/
clients/desktop/packages/target-electron/bundle_out/
clients/desktop/packages/frontend/html-dist/
clients/desktop/packages/target-browser/html-dist/
clients/desktop/packages/target-tauri/src-tauri/target/

# Android local files
clients/android/local.properties
clients/android/.idea/
clients/android/build/
clients/android/app/build/
clients/android/libs/
# but ship the prebuilt native core so the APK can be assembled on Windows without WSL/NDK
!clients/android/libs/
!clients/android/libs/**/
!clients/android/libs/*/libnative-utils.so

# iOS local files
clients/ios/Pods/
clients/ios/*.xcworkspace/xcuserdata/
clients/ios/*.xcodeproj/xcuserdata/
clients/ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# Secrets and signing
.env
*.env
*.keystore
*.jks
*.p12
*.mobileprovision
*.provisionprofile
google-services.json
GoogleService-Info.plist
secrets/
SECRETS/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local test artifacts (kept on disk for ad-hoc handoff, not committed)
artifacts/

# Throw-away VPS deploy scripts that contain credentials / SSH passwords.
.tmp-vps-*.sh
.tmp-*.sh
infra/vps/fix-ssh-console.sh
infra/vps/configure-fail2ban-soft.sh
infra/vps/run-fail2ban-soft-remote.sh
infra/vps/run-deploy-now.sh
infra/vps/cleanup-and-deploy-primary.sh
infra/vps/deploy-mirror-only.sh

# Local VPS deploy credentials (copy from .deploy.env.example).
infra/vps/.deploy.env

# Built APKs and desktop installers — staged for VPS rollout, not committed.
/releases/
infra/vps/apk/
infra/vps/desktop/
infra/vps/desktop/BMChatData/
infra/vps/_*.sh
**/__pycache__/

# Ad-hoc BMChat capture logs (verbatim adb logcat dumps).
bmchat-log-*.txt
deltachat-log-*.txt

# Build-time arch hint written by clients/android/scripts/ndk-make.sh.
clients/android/ndkArch
